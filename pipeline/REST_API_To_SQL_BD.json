{
	"name": "REST_API_To_SQL_BD",
	"properties": {
		"activities": [
			{
				"name": "Copy data Activity For API To Staging Schema DB",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['id']"
								},
								"sink": {
									"name": "id",
									"type": "Int32"
								}
							},
							{
								"source": {
									"path": "$['name']"
								},
								"sink": {
									"name": "name",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['username']"
								},
								"sink": {
									"name": "username",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['email']"
								},
								"sink": {
									"name": "email",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['address']['street']"
								},
								"sink": {
									"name": "address_street",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['address']['suite']"
								},
								"sink": {
									"name": "address_suite",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['address']['city']"
								},
								"sink": {
									"name": "address_city",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['address']['zipcode']"
								},
								"sink": {
									"name": "address_zipcode",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['address']['geo']['lat']"
								},
								"sink": {
									"name": "geo_lat",
									"type": "Decimal"
								}
							},
							{
								"source": {
									"path": "$['address']['geo']['lng']"
								},
								"sink": {
									"name": "geo_lng",
									"type": "Decimal"
								}
							},
							{
								"source": {
									"path": "$['phone']"
								},
								"sink": {
									"name": "phone",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['website']"
								},
								"sink": {
									"name": "website",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['company']['name']"
								},
								"sink": {
									"name": "company_name",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['company']['catchPhrase']"
								},
								"sink": {
									"name": "company_catchPhrase",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['company']['bs']"
								},
								"sink": {
									"name": "company_bs",
									"type": "String"
								}
							}
						],
						"collectionReference": ""
					}
				},
				"inputs": [
					{
						"referenceName": "RestResource",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "SQL_DataBase_Dataset",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Stored procedure For Transforming Data",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy data Activity For API To Staging Schema DB",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[CreateAndInsertUsers]"
				},
				"linkedServiceName": {
					"referenceName": "SQL_DataBase_LS",
					"type": "LinkedServiceReference"
				}
			}
		],
		"annotations": []
	}
}